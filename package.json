{
  "name": "dct-finance",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "setup": "pnpm install && apps/api/scripts/db.sh start && pnpm --filter @dct/api db:migrate",
    "db:start": "apps/api/scripts/db.sh start",
    "db:stop": "apps/api/scripts/db.sh stop",
    "dev": "apps/api/scripts/db.sh start && (pnpm dev:api & pnpm dev:web; wait)",
    "dev:fake": "apps/api/scripts/db.sh start && (EXTRACTION_FAKE=1 pnpm dev:api & pnpm dev:web; wait)",
    "dev:api": "pnpm --filter @dct/api dev",
    "dev:web": "pnpm --filter web dev:api",
    "dev:mock": "pnpm --filter web dev",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "lint": "pnpm -r lint",
    "eval": "pnpm --filter @dct/extraction eval",
    "probe": "pnpm --filter @dct/extraction probe"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "^9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=24"
  }
}
