# DCT Finance settings. Copy to `.env` (never commit .env) and fill in. The API reads it at startup, and variables
# already set in the environment win. Every value here is a placeholder or the default. An empty value counts as unset
# for the API; the commented-out lines are optional or read by something else, so leave them commented unless you set
# them. The API checks its settings at startup and, if one is wrong, exits naming it, never printing its value.

# ---- AI models ----
# Used by the contract harness (not built yet); the API doesn't need them to start.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# ---- Database ----
# Postgres connection URL. Unset: the local dev database that apps/api/scripts/db.sh runs. Required when the API runs
# outside the repo.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5434/DATABASE
# Connections in the API's pool, and in the job queue's (pg-boss) own pool.
# DB_POOL_MAX=10
# JOBS_DB_POOL_MAX=5
# A statement that runs longer is stopped; a write that waits longer for a lock is refused with "try again" (409).
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=10000
# Tests only: the vitest database (its name must end in _test; the tests refuse anything else). Set it in the shell:
# vitest reads it before this file loads.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5434/dct_finance_test

# ---- API server ----
# PORT=4100
# Absolute path. Default: <repo>/data/uploads. Required when the API runs outside the repo.
# UPLOAD_DIR=/ABSOLUTE/PATH/TO/uploads
# Comma-separated Host values accepted. Default: localhost and 127.0.0.1 on PORT and on the web's port 3100.
# ALLOWED_HOSTS=localhost:4100,127.0.0.1:4100,localhost:3100,127.0.0.1:3100
# Comma-separated origins allowed to write. Default: the web on port 3100.
# ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# fatal | error | warn | info | debug | trace | silent. Logs are JSON lines, each with its request's id.
# LOG_LEVEL=info
# A request must arrive in full within this (uploads are up to 50 MB); an idle keep-alive connection closes after the second.
# REQUEST_TIMEOUT_MS=120000
# KEEP_ALIVE_TIMEOUT_MS=72000
# On SIGTERM / SIGINT: how long requests and jobs get to finish before the API exits anyway.
# SHUTDOWN_TIMEOUT_MS=30000
# on | off. Finds where each line of a scanned page sits (free, on this computer's CPU, in the background) so highlights land on the words.
# LOCATE_SCANS=on

# ---- Web app (apps/web) ----
# Next.js doesn't read this file: set it in the shell or in apps/web/.env.local. It's fixed when `next dev` starts or `next build` runs.
# Where the web's /api proxy sends requests. Default: http://localhost:4100
# API_URL=http://localhost:4100

# ---- UAT sign-in (web app; shell or apps/web/.env.local) ----
# AUTH_REQUIRED=1 makes the whole site ask for a name and password (accounts: pnpm --filter @dct/api user:add <name> "<Display Name>").
# Unset: no sign-in (dev, browser tests). AUTH_SECRET is a long random string that signs the session cookie; without it nobody can sign in.
# Hosted: the API's ALLOWED_HOSTS and ALLOWED_ORIGINS must also list the public address and the host the web app calls the API on.
# AUTH_REQUIRED=…
# AUTH_SECRET=…

# ---- Browser tests (pnpm e2e; set in the shell, Playwright doesn't read this file) ----
# Browser for Playwright. Default: chrome (the installed Google Chrome); chromium after `pnpm exec playwright install chromium`.
# PW_CHANNEL=chrome
# Set by playwright.config.ts for the e2e web build (builds into apps/web/.next-e2e). Don't set it yourself.
# E2E=1
