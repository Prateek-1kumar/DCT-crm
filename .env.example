# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: claude-sonnet-5-5 reads, claude-haiku-5-5 sorts pages. (No Opus: cost decision 2026-10-26.)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
# Cost guard (USD per contract extraction, all providers). Default 1.
# EXTRACTION_MAX_USD=1
# Second reader: haiku (default, ~1-2 cents, contract terms only) | openai (costs more than the main read) | off
# CROSS_READ=haiku
# OpenAI model for the cross-check read (only with CROSS_READ=openai) (must support images + JSON schema)
OPENAI_MODEL=gpt-5.5
# USD per million input,output tokens, for the cost report (gpt-5.5 list price per third-party trackers, Oct 2026)
OPENAI_PRICE_PER_MTOK=5,30
DATABASE_URL=postgres://dct:dct@localhost:5434/dct_finance
